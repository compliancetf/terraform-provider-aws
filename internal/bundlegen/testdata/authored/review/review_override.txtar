The intents of review_pending with authored overrides for both queued ids:
the queue is empty, the authored controls win, rds stays translated.
-- intents.json --
{
  "format": "content.provider-intents/1",
  "content_version": "0.27.1",
  "content_commit": "1f2a3ad",
  "catalog_snapshot_id": "snap_20261004_000000_000000",
  "policies": [
    {"id": "iam_bobthecorp_no_kms_wildcard", "resource_type": "aws_iam_policy",
     "attributes": [{"schema_path": "policy", "condition": "contains", "values": ["kms"], "values_from_ref": null}],
     "explanation": "Attribute `policy` of `aws_iam_policy` must contain `\"kms\"`.", "postcondition": "", "has_strategy_condition": false},
    {"id": "rds_bobthecorp_storage_encrypted", "resource_type": "aws_db_instance",
     "attributes": [{"schema_path": "storage_encrypted", "condition": "equals_any", "values": [true], "values_from_ref": null}],
     "explanation": "Attribute `storage_encrypted` of `aws_db_instance` must be `true`.", "postcondition": "", "has_strategy_condition": false},
    {"id": "s3_bobthecorp_versioning_on", "resource_type": "aws_s3_bucket_versioning",
     "attributes": [{"schema_path": "versioning_configuration[0].status", "condition": "equals_any", "values": ["Enabled"], "values_from_ref": null}],
     "explanation": "", "postcondition": "", "has_strategy_condition": false}
  ]
}
-- authored/iam_bobthecorp_no_kms_wildcard.yaml --
fix: Remove kms:* from the policy.
targets:
  - {kind: resource, type: aws_iam_policy, reads: [policy], presence_mode: effective, on: [create, update], expr: 'resource.policy != ""', action: deny}
fixtures:
  - {kind: resource, type: aws_iam_policy, name: pass, bindings: {op: create, resource: {policy: "{}"}}, expect: {state: pass}}
  - {kind: resource, type: aws_iam_policy, name: fail, bindings: {op: create, resource: {policy: ""}}, expect: {state: fail}}
-- authored/s3_bobthecorp_versioning_on.yaml --
targets:
  - {kind: resource, type: aws_s3_bucket_versioning, reads: [bucket], presence_mode: configured, on: [create, update], expr: config.bucket != null, action: warn}
fixtures:
  - {kind: resource, type: aws_s3_bucket_versioning, name: pass, bindings: {op: create, config: {bucket: bobthecorp-logs}}, expect: {state: pass}}
  - {kind: resource, type: aws_s3_bucket_versioning, name: fail, bindings: {op: create, config: {}}, expect: {state: fail}}
