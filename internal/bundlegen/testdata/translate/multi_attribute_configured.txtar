-- want.json --
{
  "control": {
    "id": "cloudtrail_trail_validated_and_encrypted",
    "version": "1.0.0",
    "kind": "resource",
    "resource_type": "aws_cloudtrail",
    "reads": [
      "enable_log_file_validation",
      "kms_key_id"
    ],
    "presence_mode": "configured",
    "on": [
      "create",
      "update"
    ],
    "expr": "config.enable_log_file_validation == true && config.kms_key_id != null && size(config.kms_key_id) > 0",
