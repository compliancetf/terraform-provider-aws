{
  "id": "s3_bobthecorp_versioning_on.resource.aws_s3_bucket_versioning.pass",
  "resource_type": "aws_s3_bucket_versioning",
  "schema": "schema.json",
  "control": {
    "id": "s3_bobthecorp_versioning_on",
    "version": "1.0.0",
    "kind": "resource",
    "resource_type": "aws_s3_bucket_versioning",
    "reads": [
      "bucket"
    ],
    "presence_mode": "configured",
    "on": [
      "create",
      "update"
    ],
    "expr": "config.bucket != null",
    "action": "warn",
    "severity": "medium",
    "message": "Sample bucket versioning is on",
    "framework_refs": [
      "pci_dss_v40:S10.5",
      "soc_2:SA1"
    ],
    "exemption_coverable": []
  },
  "bindings": {
    "op": "create",
    "provider": {
      "account_id": "111111111111",
      "region": "eu-west-1"
    },
    "config": {
      "bucket": "bobthecorp-logs"
    }
  },
  "expect": {
    "state": "pass",
    "err_class": "",
    "unknown_paths": []
  }
}
