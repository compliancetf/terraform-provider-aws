{
  "format_version": "1.0",
  "provider_schemas": {
    "registry.terraform.io/hashicorp/aws": {
      "resource_identity_schemas": {
        "aws_iam_role": {
          "attributes": {
            "account_id": {
              "optional_for_import": true,
              "type": "string"
            },
            "name": {
              "required_for_import": true,
              "type": "string"
            }
          },
          "version": 0
        }
      },
      "resource_schemas": {
        "aws_iam_role": {
          "block": {
            "attributes": {
              "arn": {
                "computed": true,
                "description_kind": "plain",
                "type": "string"
              },
              "assume_role_policy": {
                "description_kind": "plain",
                "required": true,
                "type": "string"
              },
              "create_date": {
                "computed": true,
                "description_kind": "plain",
                "type": "string"
              },
              "description": {
                "description_kind": "plain",
                "optional": true,
                "type": "string"
              },
              "force_detach_policies": {
                "description_kind": "plain",
                "optional": true,
                "type": "bool"
              },
              "id": {
                "computed": true,
                "description_kind": "plain",
                "optional": true,
                "type": "string"
              },
              "managed_policy_arns": {
                "computed": true,
                "deprecated": true,
                "deprecation_message": "managed_policy_arns is deprecated. Use the aws_iam_role_policy_attachment resource instead. If Terraform should exclusively manage all managed policy attachments (the current behavior of this argument), use the aws_iam_role_policy_attachments_exclusive resource as well.",
