                  "deprecated": true,
                  "deprecation_message": "inline_policy is deprecated. Use the aws_iam_role_policy resource instead. If Terraform should exclusively manage all inline policy associations (the current behavior of this argument), use the aws_iam_role_policies_exclusive resource as well.",
                  "description_kind": "plain"
                },
                "nesting_mode": "set"
              }
            },
            "description_kind": "plain"
