[
  {
    "id": "rds_db_instance_encryption_at_rest_enabled",
    "version": "2.1.0",
    "kind": "resource",
    "resource_type": "aws_db_instance",
    "reads": ["storage_encrypted"],
    "presence_mode": "effective",
    "on": ["create", "update"],
    "expr": "resource.storage_encrypted == true",
    "action": "deny",
    "severity": "high",
    "message": "RDS storage must be encrypted at rest.",
    "fix": "Set storage_encrypted = true.",
    "framework_refs": ["soc_2:CC6.1", "cis_aws:2.3.1"],
    "exemption_coverable": ["grant"]
  },
  {
    "id": "rds_instance_kms_key_configured",
    "version": "1.0.0",
    "kind": "resource",
    "resource_type": "aws_db_instance",
    "reads": ["kms_key_id"],
    "presence_mode": "configured",
    "on": ["create"],
    "expr": "config.kms_key_id != null",
    "action": "deny",
    "severity": "medium",
    "message": "RDS instances must name a customer managed KMS key.",
    "fix": "Set kms_key_id.",
    "exemption_coverable": []
  },
  {
    "id": "rds_instance_engine_not_mysql",
    "version": "1.0.0",
    "kind": "resource",
    "resource_type": "aws_db_instance",
    "reads": ["engine"],
    "presence_mode": "effective",
    "on": ["create", "update"],
    "expr": "resource.engine != \"mysql\"",
    "action": "warn",
    "severity": "low",
    "message": "Prefer an engine other than mysql.",
    "exemption_coverable": []
  },
  {
    "id": "rds_instance_deletion_protection_enabled",
    "version": "1.0.0",
    "kind": "resource",
    "resource_type": "aws_db_instance",
    "reads": ["deletion_protection"],
    "presence_mode": "effective",
    "on": ["update"],
    "expr": "resource.deletion_protection == true",
    "action": "deny",
    "severity": "medium",
    "message": "RDS instances must keep deletion protection on.",
    "fix": "Set deletion_protection = true.",
    "exemption_coverable": []
  },
  {
    "id": "rds_instance_deletion_guard",
    "version": "1.0.0",
    "kind": "deletion_guard",
    "resource_type": "aws_db_instance",
    "reads": ["deletion_protection"],
    "on": ["delete"],
    "expr": "prior.deletion_protection == false",
    "action": "deny",
    "severity": "medium",
    "message": "Disable deletion_protection before destroying this instance.",
    "exemption_coverable": []
  },
  {
    "id": "ds_lookup_engine_postgres",
    "version": "1.0.0",
    "kind": "data_source",
    "resource_type": "aws_db_lookup",
    "reads": ["engine"],
    "presence_mode": "configured",
    "expr": "config.engine == \"postgres\"",
    "action": "deny",
    "severity": "medium",
    "message": "Lookups must query a postgres instance.",
    "fix": "Set engine = \"postgres\".",
    "exemption_coverable": []
  },
  {
    "id": "ds_lookup_encrypted",
    "version": "1.0.0",
    "kind": "data_source",
    "resource_type": "aws_db_lookup",
    "reads": ["storage_encrypted"],
    "presence_mode": "effective",
    "expr": "resource.storage_encrypted == true",
    "action": "deny",
    "severity": "high",
    "message": "The looked-up instance must be encrypted at rest.",
    "fix": "Look up an encrypted instance.",
    "exemption_coverable": []
  },
  {
    "id": "ds_lookup_deletion_protection",
    "version": "1.0.0",
    "kind": "data_source",
    "resource_type": "aws_db_lookup",
    "reads": ["deletion_protection"],
    "presence_mode": "effective",
    "expr": "resource.deletion_protection == true",
    "action": "warn",
    "severity": "low",
    "message": "The looked-up instance should keep deletion protection on.",
    "exemption_coverable": []
  }
]
