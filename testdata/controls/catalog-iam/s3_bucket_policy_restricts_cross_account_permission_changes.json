{"control": {"id": "s3_bucket_policy_restricts_cross_account_permission_changes", "version": "1.0.0", "kind": "resource", "resource_type": "aws_s3_bucket_policy", "reads": ["policy"], "presence_mode": "effective", "on": ["create", "update"], "expr": "iam.parse(resource.policy).statements.all(s, !(s.effect == \"Allow\" && [\"s3:deletebucketpolicy\", \"s3:putbucketacl\", \"s3:putbucketpolicy\", \"s3:putencryptionconfiguration\", \"s3:putobjectacl\"].exists(a, iam.grants(s, a)) && !iam.principals_in_account(s, provider.account_id, provider.partition)))", "action": "deny", "severity": "high", "message": "S3 bucket policies must not allow principals outside the account to change bucket permissions."},
 "cases": [
  {"id": "P-01-read-write-objects", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:iam::222222222222:role/bobthecorp-app"}, "Action": ["s3:GetObject", "s3:PutObject"], "Resource": "arn:aws:s3:::bobthecorp-logs/*"}]}}, "expect": {"state": "pass", "err_class": ""}},
  {"id": "P-02-deny-policy-change", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Deny", "Principal": "*", "Action": "s3:PutBucketPolicy", "Resource": "arn:aws:s3:::bobthecorp-logs"}]}}, "expect": {"state": "pass", "err_class": ""}},
  {"id": "F-01-put-bucket-policy", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:iam::222222222222:role/bobthecorp-app"}, "Action": "s3:PutBucketPolicy", "Resource": "arn:aws:s3:::bobthecorp-logs"}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-02-s3-star", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:iam::222222222222:role/bobthecorp-app"}, "Action": "s3:*", "Resource": "arn:aws:s3:::bobthecorp-logs"}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "N-06-put-wildcard-object-resource", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:iam::222222222222:role/bobthecorp-app"}, "Action": "s3:Put*", "Resource": "arn:aws:s3:::bobthecorp-logs/*"}]}}, "expect": {"state": "not_evaluable", "err_class": "unresolved"}},
  {"id": "F-04-not-action", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:iam::222222222222:role/bobthecorp-app"}, "NotAction": "s3:GetObject", "Resource": "arn:aws:s3:::bobthecorp-logs"}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "N-01-catalog-miss", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:iam::222222222222:role/bobthecorp-app"}, "Action": "s3:BobthecorpNoSuchAction", "Resource": "arn:aws:s3:::bobthecorp-logs"}]}}, "expect": {"state": "not_evaluable", "err_class": "unresolved"}},
  {"id": "P-03-own-account-role", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:iam::111111111111:role/bobthecorp-admin"}, "Action": "s3:PutBucketPolicy", "Resource": "arn:aws:s3:::bobthecorp-logs"}]}}, "expect": {"state": "pass", "err_class": ""}},
  {"id": "P-04-own-root-and-assumed-role", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": ["arn:aws:iam::111111111111:root", "arn:aws:sts::111111111111:assumed-role/bobthecorp-admin/s"]}, "Action": "s3:PutBucketPolicy", "Resource": "arn:aws:s3:::bobthecorp-logs"}]}}, "expect": {"state": "pass", "err_class": ""}},
  {"id": "F-05-own-and-other-account", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": ["arn:aws:iam::111111111111:role/bobthecorp-admin", "arn:aws:iam::222222222222:root"]}, "Action": "s3:PutBucketPolicy", "Resource": "arn:aws:s3:::bobthecorp-logs"}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-06-everyone", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": "*", "Action": "s3:PutBucketPolicy", "Resource": "arn:aws:s3:::bobthecorp-logs"}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-07-service", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "logging.s3.amazonaws.com"}, "Action": "s3:PutBucketPolicy", "Resource": "arn:aws:s3:::bobthecorp-logs"}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-08-own-federated-provider", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Federated": "arn:aws:iam::111111111111:saml-provider/bobthecorp"}, "Action": "s3:PutBucketPolicy", "Resource": "arn:aws:s3:::bobthecorp-logs"}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "N-02-not-principal", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "NotPrincipal": {"AWS": "arn:aws:iam::222222222222:root"}, "Action": "s3:PutBucketPolicy", "Resource": "arn:aws:s3:::bobthecorp-logs"}]}}, "expect": {"state": "not_evaluable", "err_class": "unresolved"}},
  {"id": "N-03-own-role-and-role-name", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": ["arn:aws:iam::111111111111:role/bobthecorp-admin", "bobthecorp-admin"]}, "Action": "s3:PutBucketPolicy", "Resource": "arn:aws:s3:::bobthecorp-logs"}]}}, "expect": {"state": "not_evaluable", "err_class": "unresolved"}},
  {"id": "N-04-bare-account-id", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "111111111111"}, "Action": "s3:PutBucketPolicy", "Resource": "arn:aws:s3:::bobthecorp-logs"}]}}, "expect": {"state": "not_evaluable", "err_class": "unresolved"}},
  {"id": "N-05-account-unknown", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:iam::111111111111:role/bobthecorp-admin"}, "Action": "s3:PutBucketPolicy", "Resource": "arn:aws:s3:::bobthecorp-logs"}]}}, "account_unknown": true, "expect": {"state": "not_evaluable", "err_class": "unresolved"}},
  {"id": "F-09-other-partition-same-account", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws-cn:iam::111111111111:root"}, "Action": "s3:PutBucketPolicy", "Resource": "arn:aws:s3:::bobthecorp-logs"}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "P-05-china-partition-own-root", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws-cn:iam::111111111111:root"}, "Action": "s3:PutBucketPolicy", "Resource": "arn:aws-cn:s3:::bobthecorp-logs"}]}}, "partition": "aws-cn", "expect": {"state": "pass", "err_class": ""}},
  {"id": "P-06-gov-partition-own-assumed-role", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws-us-gov:sts::111111111111:assumed-role/bobthecorp-admin/s"}, "Action": "s3:PutBucketPolicy", "Resource": "arn:aws-us-gov:s3:::bobthecorp-logs"}]}}, "partition": "aws-us-gov", "expect": {"state": "pass", "err_class": ""}},
  {"id": "F-10-aws-principal-in-china", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:iam::111111111111:root"}, "Action": "s3:PutBucketPolicy", "Resource": "arn:aws-cn:s3:::bobthecorp-logs"}]}}, "partition": "aws-cn", "expect": {"state": "fail", "err_class": ""}},
  {"id": "N-07-partition-unknown", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:iam::111111111111:root"}, "Action": "s3:PutBucketPolicy", "Resource": "arn:aws:s3:::bobthecorp-logs"}]}}, "partition": "$unknown", "expect": {"state": "not_evaluable", "err_class": "unresolved"}},
  {"id": "N-08-partition-not-in-list", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:iam::111111111111:root"}, "Action": "s3:PutBucketPolicy", "Resource": "arn:aws:s3:::bobthecorp-logs"}]}}, "partition": "aws-mars", "expect": {"state": "not_evaluable", "err_class": "unresolved"}}
 ]}
