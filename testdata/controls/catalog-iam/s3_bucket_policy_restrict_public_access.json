{"control": {"id": "s3_bucket_policy_restrict_public_access", "version": "1.0.0", "kind": "resource", "resource_type": "aws_s3_bucket_policy", "reads": ["policy"], "presence_mode": "effective", "on": ["create", "update"], "expr": "iam.parse(resource.policy).statements.all(s, !(s.effect == \"Allow\" && s.principal_any))", "action": "deny", "severity": "high", "message": "S3 bucket policies must not allow public principals."},
 "cases": [
  {"id": "P-01-account-principal", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:iam::222222222222:role/bobthecorp-app"}, "Action": "s3:GetObject", "Resource": "arn:aws:s3:::bobthecorp-logs/*"}]}}, "expect": {"state": "pass", "err_class": ""}},
  {"id": "P-02-deny-public-without-tls", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Deny", "Principal": "*", "Action": "s3:*", "Resource": "arn:aws:s3:::bobthecorp-logs/*", "Condition": {"Bool": {"aws:SecureTransport": "false"}}}]}}, "expect": {"state": "pass", "err_class": ""}},
  {"id": "P-03-service-principal", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "logging.s3.amazonaws.com"}, "Action": "s3:PutObject", "Resource": "arn:aws:s3:::bobthecorp-logs/*"}]}}, "expect": {"state": "pass", "err_class": ""}},
  {"id": "F-01-public", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": "*", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::bobthecorp-logs/*"}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-02-public-aws-star", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": ["*"]}, "Action": "s3:GetObject", "Resource": "arn:aws:s3:::bobthecorp-logs/*"}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-03-not-principal", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "NotPrincipal": {"AWS": "arn:aws:iam::222222222222:role/bobthecorp-app"}, "Action": "s3:GetObject", "Resource": "arn:aws:s3:::bobthecorp-logs/*"}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-04-condition-secure-transport", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": "*", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::bobthecorp-logs/*", "Condition": {"Bool": {"aws:SecureTransport": "true"}}}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-05-condition-org-id-wildcard", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": "*", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::bobthecorp-logs/*", "Condition": {"StringLike": {"aws:PrincipalOrgID": "*"}}}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-06-condition-principal-arn-self", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": "*", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::bobthecorp-logs/*", "Condition": {"StringEquals": {"aws:PrincipalArn": "${aws:PrincipalArn}"}}}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-07-condition-any-ip", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": "*", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::bobthecorp-logs/*", "Condition": {"IpAddress": {"aws:SourceIp": "0.0.0.0/0"}}}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-08-condition-for-any-value", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": "*", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::bobthecorp-logs/*", "Condition": {"ForAnyValue:StringLike": {"aws:PrincipalOrgPaths": ["o-bobthecorp/*"]}}}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-09-condition-org-id", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": "*", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::bobthecorp-logs/*", "Condition": {"StringEquals": {"aws:PrincipalOrgID": "o-bobthecorp"}}}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-10-condition-if-exists", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": "*", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::bobthecorp-logs/*", "Condition": {"StringEqualsIfExists": {"aws:PrincipalOrgID": "o-bobthecorp"}}}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-11-condition-wildcard-arn", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": "*", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::bobthecorp-logs/*", "Condition": {"ArnLike": {"aws:PrincipalArn": "arn:aws:iam::*:role/*"}}}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-12-condition-negated", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": "*", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::bobthecorp-logs/*", "Condition": {"StringNotEquals": {"aws:PrincipalAccount": "222222222222"}}}]}}, "expect": {"state": "fail", "err_class": ""}}
 ]}
