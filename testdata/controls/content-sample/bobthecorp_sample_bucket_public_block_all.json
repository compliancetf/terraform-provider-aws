  {"id": "F-01-one-false", "resource": {"block_public_acls": true, "block_public_policy": true, "ignore_public_acls": false, "restrict_public_buckets": true}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-02-one-null", "resource": {"block_public_acls": true, "block_public_policy": true, "ignore_public_acls": true}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "U-01-one-unknown", "resource": {"block_public_acls": true, "block_public_policy": true, "ignore_public_acls": true, "restrict_public_buckets": {"$unknown": true}}, "expect": {"state": "unknown", "err_class": ""}}
