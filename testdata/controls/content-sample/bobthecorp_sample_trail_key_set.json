{"about": "not_empty on a string: not null and not empty.",
 "control": {"id": "bobthecorp_sample_trail_key_set", "version": "1.0.0", "kind": "resource", "resource_type": "aws_cloudtrail", "reads": ["kms_key_id"], "presence_mode": "effective", "on": ["create", "update"], "expr": "resource.kms_key_id != null && resource.kms_key_id != \"\"", "action": "deny", "severity": "high", "message": "Sample: the trail key must be set."},
 "cases": [
  {"id": "P-01-key", "resource": {"name": "bobthecorp-trail", "kms_key_id": "arn:aws:kms:eu-west-1:111111111111:key/bobthecorp"}, "expect": {"state": "pass", "err_class": ""}},
  {"id": "F-01-null", "resource": {"name": "bobthecorp-trail"}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-02-empty", "resource": {"name": "bobthecorp-trail", "kms_key_id": ""}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "U-01-unknown", "resource": {"name": "bobthecorp-trail", "kms_key_id": {"$unknown": true}}, "expect": {"state": "unknown", "err_class": ""}}
 ]}
