{"about": "not_equals a reserved name: the intent says not_empty on username, the control is username != the reserved name; the CEL follows the control.",
 "control": {"id": "bobthecorp_sample_db_username_not_reserved", "version": "1.0.0", "kind": "resource", "resource_type": "aws_db_instance", "reads": ["username"], "presence_mode": "effective", "on": ["create", "update"], "expr": "resource.username != null && resource.username != \"bobthecorp_root\"", "action": "deny", "severity": "medium", "message": "Sample: the database must not use the reserved user name."},
 "cases": [
  {"id": "P-01-custom", "resource": {"username": "bobthecorp_dba"}, "expect": {"state": "pass", "err_class": ""}},
  {"id": "F-01-reserved", "resource": {"username": "bobthecorp_root"}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-02-null", "resource": {}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "U-01-computed", "resource": {"username": {"$unknown": true}}, "expect": {"state": "unknown", "err_class": ""}}
 ]}
