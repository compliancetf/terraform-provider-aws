{"about": "not_empty on a computed string.",
 "control": {"id": "bobthecorp_sample_instance_profile_set", "version": "1.0.0", "kind": "resource", "resource_type": "aws_instance", "reads": ["iam_instance_profile"], "presence_mode": "effective", "on": ["create", "update"], "expr": "resource.iam_instance_profile != null && resource.iam_instance_profile != \"\"", "action": "deny", "severity": "medium", "message": "Sample: the instance profile must be set."},
 "cases": [
  {"id": "P-01-profile", "resource": {"iam_instance_profile": "bobthecorp-app"}, "expect": {"state": "pass", "err_class": ""}},
  {"id": "F-01-null", "resource": {}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-02-empty", "resource": {"iam_instance_profile": ""}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "U-01-computed", "resource": {"iam_instance_profile": {"$unknown": true}}, "expect": {"state": "unknown", "err_class": ""}}
 ]}
