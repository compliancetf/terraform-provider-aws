{"about": "Two intents: equals_any and not_empty on rule[0].apply_server_side_encryption_by_default[0].*. rule is a set block, so rule[0] has no order: translated to all() over the set; the inner list block (max 1) keeps [0].",
 "control": {"id": "bobthecorp_sample_bucket_sse_kms_key", "version": "1.0.0", "kind": "resource", "resource_type": "aws_s3_bucket_server_side_encryption_configuration", "reads": ["rule", "rule.apply_server_side_encryption_by_default", "rule.apply_server_side_encryption_by_default.kms_master_key_id", "rule.apply_server_side_encryption_by_default.sse_algorithm"], "presence_mode": "effective", "on": ["create", "update"], "expr": "size(resource.rule) > 0 && resource.rule.all(r, size(r.apply_server_side_encryption_by_default) > 0 && r.apply_server_side_encryption_by_default[0].sse_algorithm in [\"aws:kms\", \"aws:kms:dsse\"] && r.apply_server_side_encryption_by_default[0].kms_master_key_id != null && r.apply_server_side_encryption_by_default[0].kms_master_key_id != \"\")", "action": "deny", "severity": "high", "message": "Sample: bucket default encryption must use a KMS key."},
 "cases": [
  {"id": "P-01-kms-key", "resource": {"bucket": "bobthecorp-logs", "rule": [{"apply_server_side_encryption_by_default": [{"sse_algorithm": "aws:kms", "kms_master_key_id": "arn:aws:kms:eu-west-1:111111111111:key/bobthecorp"}]}]}, "expect": {"state": "pass", "err_class": ""}},
  {"id": "P-02-dsse-key", "resource": {"rule": [{"apply_server_side_encryption_by_default": [{"sse_algorithm": "aws:kms:dsse", "kms_master_key_id": "alias/bobthecorp"}]}]}, "expect": {"state": "pass", "err_class": ""}},
  {"id": "F-01-aes256", "resource": {"rule": [{"apply_server_side_encryption_by_default": [{"sse_algorithm": "AES256"}]}]}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-02-kms-no-key", "resource": {"rule": [{"apply_server_side_encryption_by_default": [{"sse_algorithm": "aws:kms"}]}]}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-03-kms-empty-key", "resource": {"rule": [{"apply_server_side_encryption_by_default": [{"sse_algorithm": "aws:kms", "kms_master_key_id": ""}]}]}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-04-no-default-block", "resource": {"rule": [{"bucket_key_enabled": true}]}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "U-01-key-unknown", "resource": {"rule": [{"apply_server_side_encryption_by_default": [{"sse_algorithm": "aws:kms", "kms_master_key_id": {"$unknown": true}}]}]}, "expect": {"state": "unknown", "err_class": ""}}
 ]}
