{"about": "contains [StringNotEquals, aws:PrincipalAccount] on the policy text, as the intent states it. The structural check over iam.parse is the catalog-iam control on the same resource type.",
 "control": {"id": "bobthecorp_sample_bucket_policy_names_account", "version": "1.0.0", "kind": "resource", "resource_type": "aws_s3_bucket_policy", "reads": ["policy"], "presence_mode": "effective", "on": ["create", "update"], "expr": "resource.policy != null && resource.policy.contains(\"StringNotEquals\") && resource.policy.contains(\"aws:PrincipalAccount\")", "action": "deny", "severity": "high", "message": "Sample: the bucket policy must name the owning account in a condition."},
 "cases": [
  {"id": "P-01-deny-cross-account", "resource": {"bucket": "bobthecorp-logs", "policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Sid\": \"DenyCrossAccount\", \"Effect\": \"Deny\", \"Principal\": \"*\", \"Action\": \"s3:PutBucketPolicy\", \"Resource\": \"arn:aws:s3:::bobthecorp-logs\", \"Condition\": {\"StringNotEquals\": {\"aws:PrincipalAccount\": \"111111111111\"}}}]}"}, "expect": {"state": "pass", "err_class": ""}},
  {"id": "F-01-no-deny", "resource": {"bucket": "bobthecorp-logs", "policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Principal\": {\"AWS\": \"arn:aws:iam::111111111111:root\"}, \"Action\": \"s3:GetObject\", \"Resource\": \"arn:aws:s3:::bobthecorp-logs/*\"}]}"}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-02-other-condition-key", "resource": {"bucket": "bobthecorp-logs", "policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Deny\", \"Principal\": \"*\", \"Action\": \"s3:*\", \"Resource\": \"arn:aws:s3:::bobthecorp-logs\", \"Condition\": {\"StringNotEquals\": {\"aws:SourceVpc\": \"vpc-0bobthecorp\"}}}]}"}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "F-03-null", "resource": {"bucket": "bobthecorp-logs"}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "U-01-unknown", "resource": {"bucket": "bobthecorp-logs", "policy": {"$unknown": true}}, "expect": {"state": "unknown", "err_class": ""}}
 ]}
