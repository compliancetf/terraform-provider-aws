[
  {
    "id": "db_instance_tags_set",
    "version": "1.0.0",
    "kind": "resource",
    "resource_type": "aws_db_instance",
    "reads": [
      "tags"
    ],
    "presence_mode": "effective",
    "on": [
      "create",
      "update"
    ],
    "expr": "['tags', 'tags_all'].all(k, resource[k] != null)",
    "action": "deny",
    "severity": "high",
    "message": "RDS instances must be tagged."
  }
]
