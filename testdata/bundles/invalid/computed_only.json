[
  {
    "id": "db_instance_status_available",
    "version": "1.0.0",
    "kind": "resource",
    "resource_type": "aws_db_instance",
    "reads": [
      "status"
    ],
    "presence_mode": "configured",
    "on": [
      "create",
      "update"
    ],
    "expr": "config.status == 'available'",
    "action": "deny",
    "severity": "high",
    "message": "RDS instance must be available."
  }
]
