{"id": "X-04-object-in-object", "resource_type": "aws_s3_bucket", "schema": "testdata/schemas/aws-subset.json",
  "control": {"id": "crosscheck_x_04_object_in_object", "version": "1.0.0", "kind": "resource", "resource_type": "aws_s3_bucket", "reads": ["object_lock_configuration.rule.default_retention.mode"], "presence_mode": "effective", "on": ["create", "update"], "expr": "resource.object_lock_configuration.all(c, c.rule.all(r, r.default_retention.all(d, d.mode == \"COMPLIANCE\")))", "action": "deny", "severity": "high", "message": "Fixture control."},
  "bindings": {"op": "create", "env": "prod", "provider": {"region": "eu-west-1", "account_id": "111111111111"}, "resource": {"object_lock_configuration": [{"object_lock_enabled": "Enabled", "rule": [{"default_retention": [{"mode": {"$unknown": true}, "days": 30}]}]}]}}, "expect": {"state": "unknown", "err_class": "", "unknown_paths": ["object_lock_configuration"]}}
