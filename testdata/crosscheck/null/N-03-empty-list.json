{"id": "N-03-empty-list", "resource_type": "aws_s3_bucket", "schema": "testdata/schemas/aws-subset.json",
  "control": {"id": "crosscheck_n_03_empty_list", "version": "1.0.0", "kind": "resource", "resource_type": "aws_s3_bucket", "reads": ["cors_rule.allowed_origins"], "presence_mode": "effective", "on": ["create", "update"], "expr": "resource.cors_rule.all(r, size(r.allowed_origins) >= 1)", "action": "deny", "severity": "high", "message": "Fixture control."},
  "bindings": {"op": "create", "env": "prod", "provider": {"region": "eu-west-1", "account_id": "111111111111"}, "resource": {"cors_rule": [{"allowed_methods": ["GET"], "allowed_origins": []}]}}, "expect": {"state": "fail", "err_class": "", "unknown_paths": []}}
