{"id": "U-04", "resource_type": "aws_s3_bucket", "schema": "testdata/schemas/aws-subset.json",
  "control": {"id": "crosscheck_u_04", "version": "1.0.0", "kind": "resource", "resource_type": "aws_s3_bucket", "reads": ["cors_rule.allowed_origins"], "presence_mode": "effective", "on": ["create", "update"], "expr": "resource.cors_rule.all(r, !(\"*\" in r.allowed_origins))", "action": "deny", "severity": "high", "message": "Fixture control."},
  "bindings": {"op": "create", "env": "prod", "provider": {"region": "eu-west-1", "account_id": "111111111111"}, "resource": {"cors_rule": [{"allowed_methods": ["GET"], "allowed_origins": ["https://bobthecorp.example"]}, {"allowed_methods": ["GET"], "allowed_origins": {"$unknown": true}}, {"allowed_methods": ["GET"], "allowed_origins": ["https://bobthecorp.example"]}]}}, "expect": {"state": "unknown", "err_class": "", "unknown_paths": ["cors_rule"]}}
