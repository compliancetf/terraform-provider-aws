{"id": "U-06", "resource_type": "aws_security_group", "schema": "testdata/schemas/aws-subset.json",
  "control": {"id": "crosscheck_u_06", "version": "1.0.0", "kind": "resource", "resource_type": "aws_security_group", "reads": ["ingress.cidr_blocks"], "presence_mode": "effective", "on": ["create", "update"], "expr": "resource.ingress.all(r, !(\"0.0.0.0/0\" in r.cidr_blocks))", "action": "deny", "severity": "high", "message": "Fixture control."},
  "bindings": {"op": "create", "env": "prod", "provider": {"region": "eu-west-1", "account_id": "111111111111"}, "resource": {"ingress": [{"from_port": 22, "to_port": 22, "protocol": "tcp", "cidr_blocks": {"$unknown": true}}, {"from_port": 443, "to_port": 443, "protocol": "tcp", "cidr_blocks": ["10.0.0.0/8"]}]}}, "expect": {"state": "unknown", "err_class": "", "unknown_paths": ["ingress"]}}
