{"control": {"id": "s3_bucket_policy_absorbed_unresolved", "version": "1.0.0", "kind": "resource", "resource_type": "aws_s3_bucket_policy", "reads": ["bucket", "policy"], "presence_mode": "effective", "on": ["create", "update"], "expr": "iam.parse(resource.policy).statements.all(s, !iam.principal_is(s, \"arn:aws:iam::222222222222:role/bobthecorp-app\") || resource.bucket == \"bobthecorp-exempt\")", "action": "deny", "severity": "high", "message": "Only the exempt bucket may grant the bobthecorp-app role."},
 "cases": [
  {"id": "C-01-canonical-other", "resource": {"bucket": "bobthecorp-logs", "policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:iam::222222222222:role/bobthecorp-ops"}, "Action": "s3:GetObject", "Resource": "*"}]}}, "expect": {"state": "pass", "err_class": ""}},
  {"id": "C-02-canonical-match", "resource": {"bucket": "bobthecorp-logs", "policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:iam::222222222222:role/bobthecorp-app"}, "Action": "s3:GetObject", "Resource": "*"}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "U-01-error-or-true", "resource": {"bucket": "bobthecorp-exempt", "policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "bobthecorp-app"}, "Action": "s3:GetObject", "Resource": "*"}]}}, "expect": {"state": "not_evaluable", "err_class": "unresolved"}},
  {"id": "U-02-error-or-unknown", "resource": {"bucket": {"$unknown": true}, "policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "bobthecorp-app"}, "Action": "s3:GetObject", "Resource": "*"}]}}, "expect": {"state": "not_evaluable", "err_class": "unresolved"}},
  {"id": "U-03-unresolved-resource", "resource": {"bucket": "bobthecorp-logs", "policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:iam::222222222222:role/bobthecorp-ops"}, "Action": "s3:GetObject", "Resource": "arn:aws:s3:::bobthecorp-logs/*"}]}}, "expect": {"state": "not_evaluable", "err_class": "unresolved"}}
 ]}
