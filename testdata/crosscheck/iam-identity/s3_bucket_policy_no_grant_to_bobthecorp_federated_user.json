{"control": {"id": "s3_bucket_policy_no_grant_to_bobthecorp_federated_user", "version": "1.0.0", "kind": "resource", "resource_type": "aws_s3_bucket_policy", "reads": ["policy"], "presence_mode": "effective", "on": ["create", "update"], "expr": "iam.parse(resource.policy).statements.all(s, !(s.effect == \"Allow\" && iam.grants(s, \"s3:putbucketpolicy\") && iam.principal_is(s, \"arn:aws:sts::222222222222:federated-user/bob\")))", "action": "deny", "severity": "high", "message": "The bob federated user session must not change bucket policies."},
 "cases": [
  {"id": "C-01-exact-session", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:sts::222222222222:federated-user/bob"}, "Action": "s3:PutBucketPolicy", "Resource": "*"}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "C-02-own-account-root", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:iam::222222222222:root"}, "Action": "s3:PutBucketPolicy", "Resource": "*"}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "C-03-other-session", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:sts::222222222222:federated-user/alice"}, "Action": "s3:PutBucketPolicy", "Resource": "*"}]}}, "expect": {"state": "pass", "err_class": ""}},
  {"id": "C-04-user-other-account", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:iam::333333333333:user/bob"}, "Action": "s3:PutBucketPolicy", "Resource": "*"}]}}, "expect": {"state": "pass", "err_class": ""}},
  {"id": "C-05-user-other-partition", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws-cn:iam::222222222222:user/bob"}, "Action": "s3:PutBucketPolicy", "Resource": "*"}]}}, "expect": {"state": "pass", "err_class": ""}},
  {"id": "U-01-user-same-name", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:iam::222222222222:user/bob"}, "Action": "s3:PutBucketPolicy", "Resource": "*"}]}}, "expect": {"state": "not_evaluable", "err_class": "unresolved"}},
  {"id": "U-02-user-other-name", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:iam::222222222222:user/alice"}, "Action": "s3:PutBucketPolicy", "Resource": "*"}]}}, "expect": {"state": "not_evaluable", "err_class": "unresolved"}}
 ]}
