  {"id": "U-04-canonical-user", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"CanonicalUser": "79a59df900b949e55d96a1e698fbacedfd6e09d98eacf8f8d5218e7cd47ef2be"}, "Action": "s3:PutBucketPolicy", "Resource": "*"}]}}, "expect": {"state": "not_evaluable", "err_class": "unresolved"}},
