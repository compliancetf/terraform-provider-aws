  {"id": "C-04-service-principal", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "logging.s3.amazonaws.com"}, "Action": "s3:PutBucketPolicy", "Resource": "*"}]}}, "expect": {"state": "pass", "err_class": ""}},
  {"id": "C-05-own-account-root", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:iam::222222222222:root"}, "Action": "s3:PutBucketPolicy", "Resource": "*"}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "C-06-other-account-root", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:iam::333333333333:root"}, "Action": "s3:PutBucketPolicy", "Resource": "*"}]}}, "expect": {"state": "pass", "err_class": ""}},
