  {"id": "U-01-role-name", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "bobthecorp-app"}, "Action": "s3:PutBucketPolicy", "Resource": "*"}]}}, "expect": {"state": "not_evaluable", "err_class": "unresolved"}},
  {"id": "U-02-unique-id", "resource": {"policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"AWS": "AROAEXAMPLEBOBTHECORP1"}, "Action": "s3:PutBucketPolicy", "Resource": "*"}]}}, "expect": {"state": "not_evaluable", "err_class": "unresolved"}},
