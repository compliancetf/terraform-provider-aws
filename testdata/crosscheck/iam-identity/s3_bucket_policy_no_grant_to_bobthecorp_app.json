{"control": {"id": "s3_bucket_policy_no_grant_to_bobthecorp_app", "version": "1.0.0", "kind": "resource", "resource_type": "aws_s3_bucket_policy", "reads": ["policy"], "presence_mode": "effective", "on": ["create", "update"], "expr": "iam.parse(resource.policy).statements.all(s, !(s.effect == \"Allow\" && iam.grants(s, \"s3:putbucketpolicy\") && iam.principal_is(s, \"arn:aws:iam::222222222222:role/bobthecorp-app\")))", "action": "deny", "severity": "high", "message": "The bobthecorp-app role must not change bucket policies."},
