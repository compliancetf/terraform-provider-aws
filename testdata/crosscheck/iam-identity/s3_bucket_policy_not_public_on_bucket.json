{"control": {"id": "s3_bucket_policy_not_public_on_bucket", "version": "1.0.0", "kind": "resource", "resource_type": "aws_s3_bucket_policy", "reads": ["bucket", "policy"], "presence_mode": "effective", "on": ["create", "update"], "expr": "iam.parse(resource.policy).statements.all(s, !(s.effect == \"Allow\" && s.principal_any && iam.resource_is(s, \"arn:aws:s3:::\" + resource.bucket)))", "action": "deny", "severity": "high", "message": "Bucket policies must not allow any principal on the bucket itself."},
 "cases": [
  {"id": "C-01-canonical-match", "resource": {"bucket": "bobthecorp-logs", "policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": "*", "Action": "s3:PutBucketPolicy", "Resource": "arn:aws:s3:::bobthecorp-logs"}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "C-02-canonical-other", "resource": {"bucket": "bobthecorp-logs", "policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": "*", "Action": "s3:PutBucketPolicy", "Resource": "arn:aws:s3:::bobthecorp-other"}]}}, "expect": {"state": "pass", "err_class": ""}},
  {"id": "C-03-star-resource", "resource": {"bucket": "bobthecorp-logs", "policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": "*", "Action": "s3:PutBucketPolicy", "Resource": "*"}]}}, "expect": {"state": "fail", "err_class": ""}},
  {"id": "U-01-path-wildcard", "resource": {"bucket": "bobthecorp-logs", "policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": "*", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::bobthecorp-*"}]}}, "expect": {"state": "not_evaluable", "err_class": "unresolved"}},
  {"id": "U-02-unknown-queried-arn", "resource": {"bucket": {"$unknown": true}, "policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": "*", "Action": "s3:PutBucketPolicy", "Resource": "arn:aws:s3:::bobthecorp-logs"}]}}, "expect": {"state": "not_evaluable", "err_class": "unresolved"}},
  {"id": "U-03-policy-variable", "resource": {"bucket": "bobthecorp-logs", "policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": "*", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::${aws:username}"}]}}, "expect": {"state": "not_evaluable", "err_class": "unresolved"}},
  {"id": "U-04-not-resource", "resource": {"bucket": "bobthecorp-logs", "policy": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": "*", "Action": "s3:GetObject", "NotResource": "arn:aws:s3:::bobthecorp-other"}]}}, "expect": {"state": "not_evaluable", "err_class": "unresolved"}}
 ]}
