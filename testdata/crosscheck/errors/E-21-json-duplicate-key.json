{"id": "E-21-json-duplicate-key", "resource_type": "aws_s3_bucket", "schema": "testdata/schemas/aws-subset.json",
  "control": {"id": "crosscheck_e_21_json_duplicate_key", "version": "1.0.0", "kind": "resource", "resource_type": "aws_s3_bucket", "reads": ["policy"], "presence_mode": "configured", "on": ["create", "update"], "expr": "json.path(config.policy, \"/Statement/0/Effect\") != \"Allow\"", "action": "deny", "severity": "high", "message": "Fixture control."},
  "bindings": {"op": "create", "env": "prod", "provider": {"region": "eu-west-1", "account_id": "111111111111"}, "config": {"bucket": "bobthecorp-logs", "policy": "{\"Statement\": [{\"Effect\": \"Deny\", \"Effect\": \"Allow\", \"Sid\": \"BOBTHECORP-MARKER-1\"}]}"}}, "expect": {"state": "not_evaluable", "err_class": "type_error", "unknown_paths": []}}
