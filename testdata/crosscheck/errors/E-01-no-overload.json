{"id": "E-01-no-overload", "resource_type": "aws_db_instance", "schema": "testdata/schemas/aws-subset.json",
  "control": {"id": "crosscheck_e_01_no_overload", "version": "1.0.0", "kind": "resource", "resource_type": "aws_db_instance", "reads": ["instance_class"], "presence_mode": "effective", "on": ["create", "update"], "expr": "resource.instance_class + 1 == 2", "action": "deny", "severity": "high", "message": "Fixture control."},
  "bindings": {"op": "create", "env": "prod", "provider": {"region": "eu-west-1", "account_id": "111111111111"}, "resource": {"instance_class": "db.t3.micro", "storage_encrypted": true}}, "expect": {"state": "not_evaluable", "err_class": "type_error", "unknown_paths": []}}
